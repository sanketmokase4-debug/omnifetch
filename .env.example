# Optional: only needed if you add Gemini-powered backend features.
GEMINI_API_KEY=

# Optional: deployed site URL, e.g. https://your-app.example.com
# If set, the API CORS policy allows this origin.
APP_URL=

# Hosting platforms normally provide PORT automatically.
# PORT=3000

# Use production when deploying the Express + Vite server.
NODE_ENV=production
